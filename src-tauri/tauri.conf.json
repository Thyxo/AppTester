{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PWA Launcher",
  "version": "0.1.0",
  "identifier": "dk.thyxo.pwalauncher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "launcher",
        "title": "PWA Launcher",
        "url": "index.html",
        "width": 760,
        "height": 560,
        "minWidth": 360,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
